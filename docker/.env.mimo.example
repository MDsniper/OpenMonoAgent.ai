# Copy to docker/.env ON THE DEPLOYMENT SERVER, then edit that private file.
# docker/.env is ignored by Git. Never put a real key in this example.
OPENMONO_PROVIDER=openai-compatible
OPENMONO_ENDPOINT=https://token-plan-sgp.xiaomimimo.com/v1
OPENMONO_MODEL=mimo-v2.5-pro
OPENMONO_API_KEY=
CTX_SIZE=1048576
OPENMONO_MAX_OUTPUT_TOKENS=32768

# Absolute path to the project the agent should work on, on the server.
# The default mounts this checkout (relative to the docker/ directory).
WORKSPACE=..

# Interactive CLI over SSH; no editor server is needed for this mode.
OPENMONO_ACP_ENABLED=0
